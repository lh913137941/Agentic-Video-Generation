# Copy values into your shell environment (the app does not auto-load this file).
AVG_BACKEND=mock
AVG_PARSER=rule
AVG_DATA_DIR=./data
AVG_API_URL=http://127.0.0.1:8000
AVG_OMNI_URL=http://127.0.0.1:8091
AVG_LLM_URL=http://127.0.0.1:8001
AVG_LLM_MODEL=
AVG_LLM_API_KEY=
AVG_MAX_SHOTS=5
AVG_GENERATION_CONCURRENCY=1
AVG_WIDTH=832
AVG_HEIGHT=480
AVG_MODEL_FPS=16
AVG_MODEL_STEPS=40
# Wan T2V often requires 4k+1 frames. Use 0 to disable alignment.
AVG_MODEL_FRAME_STRIDE=4
AVG_OUTPUT_WIDTH=1280
AVG_OUTPUT_HEIGHT=720
AVG_OUTPUT_FPS=24
AVG_JOB_TIMEOUT_SECONDS=1800

# Optional OpenAI-compatible vision chat/completions endpoint.
# Server-side only. Do not put API keys into Gradio inputs.
AVG_VISION_URL=https://api.openai.com
AVG_VISION_MODEL=
AVG_VISION_API_KEY=
AVG_VISION_FRAMES=4
AVG_VISION_TIMEOUT_SECONDS=120

# V2V editing: set backend=omni or backend=fal, distinct from AVG_VISION_*.
# You can also save locally in Gradio's "V2V API 配置" panel, then restart API.
# AVG_BACKEND=fal
# FAL_KEY=your-fal-key
# AVG_FAL_MODEL=fal-ai/wan/v2.7/edit-video
# AVG_BACKEND=omni
# AVG_OMNI_URL=http://127.0.0.1:8091
